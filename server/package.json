{
  "name": "momentobooth-pwa",
  "version": "1.0.0",
  "description": "MomentoBooth PWA — photobooth mobile avec filtres temps réel, minuteur, fonds, stickers, partage (QR/WhatsApp/SMS/email).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test server.test.js",
    "lint": "cd .. && server/node_modules/.bin/eslint --config server/eslint.config.js server/server.js public/js/*.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/smoke.spec.js -g \"WCAG critique\"",
    "test:coverage:experimental": "c8 --reporter=text --reporter=lcov --clean --exclude=server.test.js node --test server.test.js",
    "test:a11y:strict": "AXE_STRICT=1 playwright test tests/e2e/smoke.spec.js -g \"WCAG critique\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "multer": "^2.2.0",
    "pureimage": "^0.4.20",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0"
  }
}
