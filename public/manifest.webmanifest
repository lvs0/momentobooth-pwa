{
  "name": "MomentoBooth — Photobooth",
  "short_name": "MomentoBooth",
  "description": "Photobooth mobile : filtres temps réel, minuteur, fonds, masques visage. Capturez et partagez vos photos.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a1633",
  "theme_color": "#0a1633",
  "categories": ["photography", "entertainment", "lifestyle"],
  "lang": "fr",
  "dir": "ltr",
  "display_override": ["standalone", "minimal-ui"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png?v=25", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/icon-512.png?v=25", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/apple-touch-icon-180.png?v=25", "sizes": "180x180", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Prendre une photo", "url": "/", "icons": [{ "src": "/icons/icon-192.png?v=25", "sizes": "192x192" }] },
    { "name": "Galerie", "url": "/#gallery", "icons": [{ "src": "/icons/icon-192.png?v=14", "sizes": "192x192" }] }
  ]
}
